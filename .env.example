# Copie este arquivo para .env e preencha com seus valores reais
# cp .env.example .env

CLIENTE1_NOME="Nome do Cliente 1"
CLIENTE1_SUBDOMINIO="subdominio1"
CLIENTE1_TOKEN="seu_token_jwt_aqui"
CLIENTE1_VENCIMENTO="2026-01-01"

CLIENTE2_NOME="Nome do Cliente 2"
CLIENTE2_SUBDOMINIO="subdominio2"
CLIENTE2_TOKEN="seu_token_jwt_aqui"
CLIENTE2_VENCIMENTO="2026-01-01"

CLIENTE3_NOME="Nome do Cliente 3"
CLIENTE3_SUBDOMINIO="subdominio3"
CLIENTE3_TOKEN="seu_token_jwt_aqui"
CLIENTE3_VENCIMENTO="2026-01-01"

# ── Integração Kommo → Trello (opcional) ──
# Chave e token: https://trello.com/power-ups/admin → sua Power-Up → API key → gerar Token
TRELLO_API_KEY="sua_api_key_trello"
TRELLO_TOKEN="seu_token_trello"
# Intervalo da sincronização completa automática (0 desativa)
TRELLO_SYNC_INTERVALO_MIN=15

# Sync 1: funil do Kommo → quadro do Trello
# SUBDOMINIO deve ser igual ao de um CLIENTEn acima (é o token dele que é usado)
TRELLO_SYNC1_SUBDOMINIO="cassianogueira"
TRELLO_SYNC1_PIPELINE_ID="14338679"
# ID do quadro: abra o quadro e use o trecho da URL trello.com/b/<ID>/...
TRELLO_SYNC1_BOARD_ID="id_do_quadro"
# Cria listas/cartões também para "Ganho" e "Perdido" (sim/nao)
TRELLO_SYNC1_INCLUIR_FECHADOS="sim"
# Segredo do webhook do Kommo (tempo real). URL a cadastrar no Kommo:
# https://SEU_DOMINIO/api/webhooks/kommo/1?secret=ESTE_VALOR
TRELLO_SYNC1_WEBHOOK_SECRET="troque_por_um_valor_aleatorio"
