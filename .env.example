# Copie este arquivo para .env e preencha com seus valores reais
# cp .env.example .env

CLIENTE1_NOME="Nome do Cliente 1"
CLIENTE1_SUBDOMINIO="subdominio1"
CLIENTE1_TOKEN="seu_token_jwt_aqui"
CLIENTE1_VENCIMENTO="2026-01-01"

CLIENTE2_NOME="Nome do Cliente 2"
CLIENTE2_SUBDOMINIO="subdominio2"
CLIENTE2_TOKEN="seu_token_jwt_aqui"
CLIENTE2_VENCIMENTO="2026-01-01"

CLIENTE3_NOME="Nome do Cliente 3"
CLIENTE3_SUBDOMINIO="subdominio3"
CLIENTE3_TOKEN="seu_token_jwt_aqui"
CLIENTE3_VENCIMENTO="2026-01-01"

# ── Integração Kommo (Ganho) → Trello (Produção) ──
# Subdomínio da conta Kommo e funil monitorado
KOMMO_TRELLO_SUBDOMINIO="cassianogueira"
KOMMO_TRELLO_PIPELINE_ID="14338679"
# Token de longa duração do Kommo (opcional se já houver um CLIENTEn com o mesmo subdomínio)
KOMMO_TRELLO_TOKEN=""
# Chave e token da API do Trello (https://trello.com/power-ups/admin)
TRELLO_API_KEY=""
TRELLO_TOKEN=""
# ID da lista "Produção" (descubra em /api/integracao/trello/listas?segredo=...)
TRELLO_LISTA_PRODUCAO_ID=""
# Opcional: IDs de etiquetas separados por vírgula
TRELLO_ETIQUETAS_IDS=""
# Segredo usado na URL do webhook e nas rotas da integração
WEBHOOK_SEGREDO="troque-por-um-valor-aleatorio"
